+func (s *StartedService) scheduleStartupSelectorRTT(instance *Instance) {
+	if !urltest.RTTEnabled() {
+		return
+	}
+	go func() {
+		timer := time.NewTimer(startupSelectorRTTDelay)
+		defer timer.Stop()
+		select {
+		case <-timer.C:
+		case <-instance.ctx.Done():
+			return
+		}
+
+		s.serviceAccess.RLock()
+		active := s.instance == instance && s.serviceStatus.Status == ServiceStatus_STARTED
+		s.serviceAccess.RUnlock()
+		if !active {
+			return
+		}
+
+		var selectors []adapter.Outbound
+		for _, outbound := range instance.outboundManager.Outbounds() {
+			if _, isSelector := outbound.(*group.Selector); isSelector {
+				selectors = append(selectors, outbound)
+			}
+		}
+		if len(selectors) == 0 {
+			return
+		}
+		group.RTTTestSelectorOutbounds(
+			instance.ctx,
+			instance.outboundManager,
+			instance.urlTestHistoryStorage,
+			instance.logFactory.Logger(),
+			selectors,
+			"",
+			startupSelectorRTTFreshness,
+			false,
+		)
+	}()
+}
+
 func (s *StartedService) Close() {
 	s.serviceAccess.Lock()
 	s.closed = true
