diff --git a/experimental/cachefile/cache_test.go b/experimental/cachefile/cache_test.go
new file mode 100644
index 0000000..f540f49
--- /dev/null
+++ b/experimental/cachefile/cache_test.go
@@ -0,0 +1,78 @@
+package cachefile
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/sagernet/bbolt"
+)
+
+func openSelectedCacheDatabase(t *testing.T) *bbolt.DB {
+	t.Helper()
+	database, err := bbolt.Open(filepath.Join(t.TempDir(), "cache.db"), 0o600, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if closeErr := database.Close(); closeErr != nil {
+			t.Error(closeErr)
+		}
+	})
+	return database
+}
+
+func selectedCacheForTest(database *bbolt.DB, cacheID string, selectedCacheID string) *CacheFile {
+	var cacheIDBytes []byte
+	if cacheID != "" {
+		cacheIDBytes = append([]byte{0}, []byte(cacheID)...)
+	}
+	return &CacheFile{
+		cacheID:         cacheIDBytes,
+		cacheIDText:     cacheID,
+		selectedCacheID: selectedCacheID,
+		DB:              database,
+		pending:         newPendingWrites(),
+	}
+}
+
+func TestSelectedCacheIsolatedByProfile(t *testing.T) {
+	database := openSelectedCacheDatabase(t)
+	firstProfile := selectedCacheForTest(database, "", "sfa-profile-1")
+	secondProfile := selectedCacheForTest(database, "", "sfa-profile-2")
+	if err := firstProfile.StoreSelected("selector", "proxy-a"); err != nil {
+		t.Fatal(err)
+	}
+	if err := secondProfile.StoreSelected("selector", "proxy-b"); err != nil {
+		t.Fatal(err)
+	}
+	if selected := firstProfile.LoadSelected("selector"); selected != "proxy-a" {
+		t.Fatalf("unexpected first profile selection: %q", selected)
+	}
+	if selected := secondProfile.LoadSelected("selector"); selected != "proxy-b" {
+		t.Fatalf("unexpected second profile selection: %q", selected)
+	}
+}
+
+func TestSelectedCacheDoesNotUseLegacySharedSelection(t *testing.T) {
+	database := openSelectedCacheDatabase(t)
+	legacyCache := selectedCacheForTest(database, "", "")
+	profileCache := selectedCacheForTest(database, "", "sfa-profile-1")
+	if err := legacyCache.StoreSelected("selector", "proxy-a"); err != nil {
+		t.Fatal(err)
+	}
+	if selected := profileCache.LoadSelected("selector"); selected != "" {
+		t.Fatalf("legacy selection was unexpectedly loaded: %q", selected)
+	}
+}
+
+func TestSelectedCacheKeepsConfiguredCacheShared(t *testing.T) {
+	database := openSelectedCacheDatabase(t)
+	firstProfile := selectedCacheForTest(database, "custom-cache", "sfa-profile-1")
+	secondProfile := selectedCacheForTest(database, "custom-cache", "sfa-profile-2")
+	if err := firstProfile.StoreMode("global"); err != nil {
+		t.Fatal(err)
+	}
+	if mode := secondProfile.LoadMode(); mode != "global" {
+		t.Fatalf("configured cache data was unexpectedly isolated: %q", mode)
+	}
+}
