+// Keep the closed instance out of the caller's stack during pre-reload GC.
+// The caller holds serviceAccess; this method releases it before closing.
+//
+//go:noinline
+func (s *StartedService) closeInstanceForReload() {
+	instance := s.instance
+	s.instance = nil
+	s.updateStatus(ServiceStatus_STOPPING)
+	s.serviceAccess.Unlock()
+	_ = instance.Close()
+}
