diff --git a/daemon/reload_memory_test.go b/daemon/reload_memory_test.go
new file mode 100644
--- /dev/null
+++ b/daemon/reload_memory_test.go
@@ -0,0 +1,54 @@
+package daemon
+
+import (
+	"context"
+	"testing"
+	"weak"
+
+	box "github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/certificate"
+	"github.com/sagernet/sing-box/adapter/endpoint"
+	"github.com/sagernet/sing-box/adapter/inbound"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	boxService "github.com/sagernet/sing-box/adapter/service"
+	"github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing-box/dns/transport/local"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/protocol/direct"
+)
+
+func TestReloadReleasesOldInstanceBeforeReplacement(t *testing.T) {
+	var previous weak.Pointer[Instance]
+	registry := outbound.NewRegistry()
+	outbound.Register[option.DirectOutboundOptions](registry, "direct", func(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.DirectOutboundOptions) (adapter.Outbound, error) {
+		if previous.Value() != nil {
+			t.Error("closed instance is still retained while constructing its replacement")
+		}
+		return direct.NewOutbound(ctx, router, logger, tag, options)
+	})
+	dnsRegistry := dns.NewTransportRegistry()
+	local.RegisterTransport(dnsRegistry)
+	ctx := box.Context(context.Background(), inbound.NewRegistry(), registry, endpoint.NewRegistry(), dnsRegistry, boxService.NewRegistry(), certificate.NewRegistry())
+	s := NewStartedService(ServiceOptions{Context: ctx, LogMaxLines: 10})
+	t.Cleanup(func() {
+		_ = s.CloseService()
+		s.Close()
+	})
+	const config = `{"log":{"disabled":true},"outbounds":[{"type":"direct","tag":"direct"}]}`
+	for i := 0; i < 4; i++ {
+		if err := s.StartOrReloadService(ctx, config, &OverrideOptions{}); err != nil {
+			t.Fatal(err)
+		}
+		if s.serviceStatus.Status != ServiceStatus_STARTED {
+			t.Fatalf("unexpected service status after reload: %v", s.serviceStatus.Status)
+		}
+		previous = weakCurrentInstance(s)
+	}
+}
+
+//go:noinline
+func weakCurrentInstance(s *StartedService) weak.Pointer[Instance] {
+	return weak.Make(s.instance)
+}
